MW_Unintentional =~  BMW3_UN_01_z + BMW3_UN_02_z + BMW3_UN_03_z + BMW3_UN_04_z
MW_intentional =~ BMW3_IN_01_z + BMW3_IN_02_z + BMW3_IN_03_z + BMW3_IN_04_z

TUT_Unintentional =~ MWsum_unint_nback_easy_z + MWsum_unint_nback_difficult_z + MWsum_unint_cmt_easy_z + 
MWsum_unint_cmt_difficult_z + MWsum_unint_ms_easy_z + MWsum_unint_ms_difficult_z

TUT_intentional =~ MWsum_int_nback_easy_z + MWsum_int_nback_difficult_z + MWsum_int_cmt_easy_z + 
MWsum_int_cmt_difficult_z + MWsum_int_ms_easy_z + MWsum_int_ms_difficult_z

TUT_Unintentional ~~ TUT_intentional

TUT_Unintentional ~ MW_Unintentional + 0*MW_intentional 
TUT_intentional ~ 0*MW_Unintentional + MW_intentional

BMW3_UN_01_z ~ 0
BMW3_UN_02_z ~ 0
