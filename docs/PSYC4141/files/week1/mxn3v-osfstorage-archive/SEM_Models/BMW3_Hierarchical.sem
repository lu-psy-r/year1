MW_Unintentional =~  BMW3_UN_01 + BMW3_UN_02 + BMW3_UN_03 + BMW3_UN_04 
MW_intentional =~ BMW3_IN_01 + BMW3_IN_02 + BMW3_IN_03 + BMW3_IN_04
MW_MetaAwareness =~ BMW3_ME_01 + BMW3_ME_02 + BMW3_ME_03 + BMW3_ME_04

# specify higher order factor
MW_general =~ MW_Unintentional + MW_intentional + MW_MetaAwareness

# constrain residual variance of unintential first order factor
MW_Unintentional ~~ 0*MW_Unintentional
