TUT_Unintentional =~ MWsum_unint_nback_easy_z + MWsum_unint_nback_difficult_z + MWsum_unint_cmt_easy_z + 
MWsum_unint_cmt_difficult_z + MWsum_unint_ms_easy_z + MWsum_unint_ms_difficult_z

TUT_intentional =~ MWsum_int_nback_easy_z + MWsum_int_nback_difficult_z + MWsum_int_cmt_easy_z + 
MWsum_int_cmt_difficult_z + MWsum_int_ms_easy_z + MWsum_int_ms_difficult_z

TUT_Unintentional ~~ TUT_intentional

SSpan =~ 1*SspanPartialScoreBlock1_z + 1*SspanPartialScoreBlock2_z
OSpan =~ 1*OspanPartialScoreBlock1_z + 1*OspanPartialScoreBlock2_z
WMC =~ 1*SSpan + 1*OSpan

WMC ~~ TUT_intentional + TUT_Unintentional
                  
MWsum_unint_nback_easy_z ~ 0
MWsum_unint_nback_difficult_z ~ 0
MWsum_unint_cmt_easy_z ~ 0 
MWsum_unint_cmt_difficult_z ~ 0
MWsum_unint_ms_easy_z ~ 0
MWsum_unint_ms_difficult_z ~ 0
MWsum_int_nback_easy_z ~ 0
MWsum_int_nback_difficult_z ~ 0
MWsum_int_cmt_easy_z ~ 0 
MWsum_int_cmt_difficult_z ~ 0
MWsum_int_ms_easy_z ~ 0
MWsum_int_ms_difficult_z ~ 0
SspanPartialScoreBlock1_z ~ 0
SspanPartialScoreBlock2_z ~ 0
OspanPartialScoreBlock1_z ~ 0
OspanPartialScoreBlock2_z ~ 0
